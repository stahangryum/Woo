   "source": [
    "ggplot(penguins_clean, \n",
    "       aes(x = bill_length_mm, y = bill_depth_mm, \n",
    "           size = body_mass_g, color = species)) +\n",
    "  geom_point(alpha = 0.6) +\n",
    "  geom_smooth(method = \"lm\", se = FALSE, linewidth = 1.5, show.legend = FALSE) +\n",
    "  \n",
    "  scale_size(range = c(2, 12)) + # 점 크기 범위 조절\n",
    "  labs(\n",
    "    title = \"펭귄의 부리 모양과 체급\",\n",
    "    subtitle = \"점의 크기는 체질량을 의미\",\n",
    "    x = \"부리 길이 (mm)\",\n",
    "    y = \"부리 깊이 (mm)\",\n",
    "    color = \"펭귄 종\",\n",
    "    size = \"체질량 (g)\"\n",
    "  ) +\n",
    "  theme_minimal()"
   ]
