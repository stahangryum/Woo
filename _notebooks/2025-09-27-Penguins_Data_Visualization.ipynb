   "source": [
    "## Explore univariate data"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7da0cdb7-3c4f-48be-927b-5c47bcd9b2d7",
   "metadata": {},
   "source": [
    "### Define a visualization function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "13b45f50-5a2d-433b-bac7-e31bdb272619",
   "metadata": {},
   "outputs": [],
   "source": [
    "#범주형 변수 시각화 함수 정의\n",
    "viz_categorical_variable <- function(colname, title, x_name) {\n",
    "  penguins_clean %>%\n",
    "    count({{ colname }}) %>%\n",
    "    ggplot(aes(x = {{ colname }}, y = n, fill = {{ colname }})) +\n",
    "    geom_col() +\n",
    "    labs(title = title,\n",
    "         x = x_name,\n",
    "         y = '개체 수') +\n",
    "    theme_minimal()\n",
    "}\n",
    "\n",
    "\n",
    "# 수치형 변수 시각화 함수 정의\n",
    "# data: 사용할 데이터프레임\n",
    "# variable: 시각화할 컬럼 이름\n",
    "visualize_numeric <- function(data, variable) {\n",
    "  \n",
    "  # {{ variable }} 구문은 tidyverse 함수 내에서 인자로 받은 변수 이름을\n",
    "  # 실제 컬럼명으로 인식하게 해주는 \"마법\"과 같은 역할을 합니다.\n",
    "  \n",
    "  # 인자로 받은 변수 이름을 문자열로 저장 (그래프 제목에 사용)\n",
    "  var_name <- rlang::as_label(rlang::enquo(variable))\n",
    "  \n",
    "  # 시각화 전, 해당 컬럼의 결측치(NA) 제거\n",
    "  clean_data <- data %>%\n",
    "    drop_na({{ variable }})\n",
    "  \n",
    "  # 1. 히스토그램\n",
    "  p_hist <- ggplot(data = clean_data, aes(x = {{ variable }})) +\n",
    "    geom_histogram(fill = \"skyblue\", color = \"white\", bins = 20) +\n",
    "    labs(\n",
    "      title = paste(var_name, \"분포\"),\n",
    "      subtitle = \"Histogram\",\n",
    "      x = var_name,\n",
    "      y = \"빈도\"\n",
    "    ) +\n",
    "    theme_minimal()\n",
    "\n",
    "    # 2. 밀도곡선\n",
    "  p_m <- ggplot(penguins, aes(x = {{ variable }})) +\n",
    "  geom_density(fill = \"lightgreen\", alpha = 0.5) +\n",
    "  labs(title = \"분포\",\n",
    "       x = \"몸무게(g)\",\n",
    "       y = \"밀도\") +\n",
    "  theme_minimal()\n",
    "  \n",
    "  # 3. 상자 그림\n",
    "  p_box <- ggplot(data = clean_data, aes(y = {{ variable }})) +\n",
    "    geom_boxplot(fill = \"lightgreen\", width = 0.4) +\n",
    "    labs(\n",
    "      title = paste(var_name, \"분포\"),\n",
    "      subtitle = \"Box Plot\",\n",
    "      y = var_name\n",
    "    ) +\n",
    "    theme_minimal() +\n",
    "    theme(axis.text.x = element_blank(), axis.ticks.x = element_blank())\n",
    "\n",
    "  \n",
    "  \n",
    "  # patchwork를 이용해 두 그래프를 합쳐서 반환\n",
    "  return(p_hist + p_m + p_box)\n",
    "}"
   ]
  },
