   "source": [
    "# facet 분할\n",
    "ggplot(penguins_clean, \n",
    "       aes(x = bill_length_mm, y = bill_depth_mm, color = species)) +\n",
    "  geom_point(alpha = 0.6) +\n",
    "  facet_wrap(~ species) +\n",
    "  labs(\n",
    "    title = \"부리 길이와 부리 깊이의 관계\",\n",
    "    x = \"부리 길이 (mm)\",\n",
    "    y = \"부리 깊이 (mm)\",\n",
    "    color = \"펭귄 종\"\n",
    "  ) +\n",
    "  theme_minimal()"
   ]
  },
