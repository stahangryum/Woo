## 단일 변수 탐색
<details>
<summary>시각화 함수 접기/펼치기</summary>


```{r}
#범주형 변수 시각화 함수 정의
viz_categorical_variable <- function(colname, title, x_name) {
  penguins_clean %>%
    count({{ colname }}) %>%
    ggplot(aes(x = {{ colname }}, y = n, fill = {{ colname }})) +
    geom_col() +
    labs(title = title,
         x = x_name,
         y = '개체 수') +
    theme_minimal()
}


# 수치형 변수 시각화 함수 정의
# data: 사용할 데이터프레임
# variable: 시각화할 컬럼 이름
visualize_numeric <- function(data, variable) {
  
  # {{ variable }} 구문은 tidyverse 함수 내에서 인자로 받은 변수 이름을
  # 실제 컬럼명으로 인식하게 해주는 "마법"과 같은 역할을 합니다.
  
  # 인자로 받은 변수 이름을 문자열로 저장 (그래프 제목에 사용)
  var_name <- rlang::as_label(rlang::enquo(variable))
  
  # 시각화 전, 해당 컬럼의 결측치(NA) 제거
  clean_data <- data %>%
    drop_na({{ variable }})
  
  # 1. 히스토그램
  p_hist <- ggplot(data = clean_data, aes(x = {{ variable }})) +
    geom_histogram(fill = "skyblue", color = "white", bins = 20) +
    labs(
      title = paste(var_name, "분포"),
      subtitle = "Histogram",
      x = var_name,
      y = "빈도"
    ) +
    theme_minimal()

    # 2. 밀도곡선
  p_m <- ggplot(penguins, aes(x = {{ variable }})) +
  geom_density(fill = "lightgreen", alpha = 0.5) +
  labs(title = "분포",
       x = "몸무게(g)",
       y = "밀도") +
  theme_minimal()
  
  # 3. 상자 그림
  p_box <- ggplot(data = clean_data, aes(y = {{ variable }})) +
    geom_boxplot(fill = "lightgreen", width = 0.4) +
    labs(
      title = paste(var_name, "분포"),
      subtitle = "Box Plot",
      y = var_name
    ) +
    theme_minimal() +
    theme(axis.text.x = element_blank(), axis.ticks.x = element_blank())

  
  
  # patchwork를 이용해 두 그래프를 합쳐서 반환
  return(p_hist + p_m + p_box)
}

```

</details>

